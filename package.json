{
  "name": "dbml-previewer-plus",
  "displayName": "DBML Previewer Plus",
  "description": "Transform DBML files into interactive visual database diagrams with drag-and-drop tables, relationship tooltips, multi-schema support, and real-time preview updates",
  "version": "1.6.1",
  "publisher": "ctnguyen",
  "author": {
    "name": "Rizky Kurniawan",
    "email": "contact.rizkykurniawan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kykurniawan/vscode-dbml-previewer.git"
  },
  "homepage": "https://github.com/kykurniawan/vscode-dbml-previewer#readme",
  "bugs": {
    "url": "https://github.com/kykurniawan/vscode-dbml-previewer/issues"
  },
  "keywords": [
    "dbml",
    "database",
    "diagram",
    "preview",
    "visualization",
    "schema",
    "erd",
    "database design",
    "sql",
    "interactive",
    "relationships",
    "flow chart",
    "entity relationship",
    "database modeling",
    "postgresql",
    "mysql",
    "database schema",
    "table relationships",
    "visual database"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbml-previewer-plus.preview",
        "title": "Preview DBML",
        "category": "DBML Previewer",
        "icon": "$(open-preview)"
      },
      {
        "command": "dbml-previewer-plus.previewFromExplorer",
        "title": "Preview DBML",
        "category": "DBML Previewer"
      },
      {
        "command": "dbml-previewer-plus.exportToPNG",
        "title": "Export Diagram to PNG",
        "category": "DBML Previewer",
        "icon": "$(device-camera)"
      },
      {
        "command": "dbml-previewer-plus.exportToSVG",
        "title": "Export Diagram to SVG",
        "category": "DBML Previewer",
        "icon": "$(file-media)"
      },
      {
        "command": "dbml-previewer-plus.bulkExportToPNG",
        "title": "Bulk Export DBML Files to PNG",
        "category": "DBML Previewer",
        "icon": "$(export)"
      },
      {
        "command": "dbml-previewer-plus.bulkExportToSVG",
        "title": "Bulk Export DBML Files to SVG",
        "category": "DBML Previewer",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dbml-previewer-plus.previewFromExplorer",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        },
        {
          "command": "dbml-previewer-plus.bulkExportToPNG",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "dbml-previewer-plus.bulkExportToSVG",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "dbml-previewer-plus.preview",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dbml-previewer-plus.preview",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dbml-previewer-plus.preview",
          "when": "resourceExtname == .dbml"
        },
        {
          "command": "dbml-previewer-plus.previewFromExplorer",
          "when": "false"
        },
        {
          "command": "dbml-previewer-plus.exportToPNG",
          "when": "dbmlPreviewerPlusActive"
        },
        {
          "command": "dbml-previewer-plus.exportToSVG",
          "when": "dbmlPreviewerPlusActive"
        },
        {
          "command": "dbml-previewer-plus.bulkExportToPNG"
        },
        {
          "command": "dbml-previewer-plus.bulkExportToSVG"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbml-previewer-plus.bulkExportToPNG",
        "key": "ctrl+shift+alt+e",
        "mac": "cmd+shift+alt+e"
      },
      {
        "command": "dbml-previewer-plus.bulkExportToSVG",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      }
    ],
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "DBML Previewer",
      "properties": {
        "dbmlPreviewerPlus.inheritThemeStyle": {
          "type": "boolean",
          "default": false,
          "description": "Whether to inherit styling from the current VS Code theme. When disabled, uses a clean light theme optimized for diagram readability."
        },
        "dbmlPreviewerPlus.edgeType": {
          "type": "string",
          "default": "smoothstep",
          "enum": [
            "straight",
            "smoothstep",
            "bezier"
          ],
          "enumDescriptions": [
            "Straight line between nodes",
            "Smooth step edge with rounded corners",
            "Bezier curve edge"
          ],
          "description": "The type of edge/connection lines to use for table relationships in the diagram."
        },
        "dbmlPreviewerPlus.autoEndpointSide": {
          "type": "boolean",
          "default": true,
          "description": "Automatically choose which side of each table a relationship connects to, so edges leave and enter on the side facing the related table. When disabled, edges always leave the right side and enter the left side."
        },
        "dbmlPreviewerPlus.relationshipMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Show entity-relationship markers on relationship edges: a crow's-foot on the many side and a bar on the one side."
        },
        "dbmlPreviewerPlus.editableEdgeRouting": {
          "type": "boolean",
          "default": true,
          "description": "Allow editing relationship routes by dragging waypoints. When enabled, select or hover an edge to reveal draggable points and segment handles; drag a point to bend the edge, drag a segment to add a point, double-click a point to delete it. Saved routes are always rendered regardless of this setting."
        },
        "dbmlPreviewerPlus.showCardinalityLabels": {
          "type": "boolean",
          "default": false,
          "description": "Show cardinality labels on relationship edges in the diagram. 1 = one-side, * = many-side."
        },
        "dbmlPreviewerPlus.exportQuality": {
          "type": "number",
          "default": 0.95,
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "Image quality for PNG exports (0.1 to 1.0). Higher values produce better quality but larger file sizes."
        },
        "dbmlPreviewerPlus.exportBackground": {
          "type": "boolean",
          "default": true,
          "description": "Include background in exported images. When disabled, exported images have a transparent background."
        },
        "dbmlPreviewerPlus.exportPadding": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "description": "Padding around the diagram in exported images (in pixels)."
        },
        "dbmlPreviewerPlus.bulkExport.outputFolder": {
          "type": "string",
          "default": "",
          "description": "Path to folder where bulk-exported PNG files will be saved. Relative paths resolve from workspace root. Leave empty to save into a 'dbml-exports' subfolder inside the source folder."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "test:unit": "mocha 'test-unit/**/*.test.js'",
    "check:prod-bundle": "node scripts/check-no-jsxdev.js",
    "build": "webpack --mode production && npm run check:prod-bundle",
    "watch": "webpack --mode development --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "@dbml/core": "^3.2.0",
    "html-to-image": "1.11.11"
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^10.8.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.6",
    "babel-loader": "^10.1.1",
    "css-loader": "^6.8.0",
    "mocha": "^12.0.2",
    "style-loader": "^3.3.0"
  }
}